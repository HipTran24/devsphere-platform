# Copy to .env, replace the value with a generated local password, then run docker compose up -d.
DATABASE_USER=devsphere_app
DATABASE_PASSWORD=replace-with-a-random-local-password
MIGRATION_USER=devsphere
MIGRATION_PASSWORD=replace-with-a-different-owner-password
DATABASE_PORT=54329
DATABASE_NAME=devsphere
DATABASE_URL=jdbc:postgresql://localhost:54329/devsphere

# Optional registration settings. Supply both Base64-encoded 32-byte keys via environment.
# AUTH_OTP_HMAC_KEY=
# AUTH_OTP_ENCRYPTION_KEY=
# AUTH_MAIL_FROM=
# SPRING_MAIL_HOST and other SMTP settings are configured through environment variables.
