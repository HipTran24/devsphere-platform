# Copy to .env, replace the value with a generated local password, then run docker compose up -d.
DATABASE_USER=devsphere_app
DATABASE_PASSWORD=replace-with-a-random-local-password
MIGRATION_USER=devsphere
MIGRATION_PASSWORD=replace-with-a-different-owner-password
DATABASE_PORT=54329
DATABASE_NAME=devsphere
DATABASE_URL=jdbc:postgresql://localhost:54329/devsphere

# Optional registration settings. Supply both Base64-encoded 32-byte keys via environment.
# AUTH_OTP_HMAC_KEY=
# AUTH_OTP_ENCRYPTION_KEY=
# AUTH_MAIL_FROM=
# SPRING_MAIL_HOST and other SMTP settings are configured through environment variables.


# Required backend session JWT signing key. Use a locally generated 32-byte Base64 value.
# Supply it to the backend process using your secret manager or shell environment.
AUTH_SESSION_SIGNING_KEY=

# =============================================================================
# Production deployment (compose.prod.yaml)
# Copy to .env on the server (chmod 600) and replace EVERY placeholder.
# Generate secrets with: openssl rand -base64 32
# =============================================================================

# --- Public edge (Nginx + Let's Encrypt) ---
NGINX_SERVER_NAME=devsphere.example.com
LETSENCRYPT_EMAIL=ops@example.com

# --- Backend runtime (container network overrides DATABASE_URL automatically) ---
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -Dmanagement.metrics.distribution.percentiles-histogram.http.server.requests=true
DATABASE_POOL_SIZE=20
AUTH_SESSION_ISSUER=devsphere
AUTH_SESSION_AUDIENCE=devsphere-api

# --- Redis (password required; Redis is only reachable on the internal network) ---
REDIS_PASSWORD=replace-with-a-random-redis-password

# --- AWS S3 attachments (presigned URLs, max TTL 300s) ---
# Credentials come from the EC2 instance profile; never put access keys here.
AWS_REGION=ap-southeast-1
S3_BUCKET=devsphere-attachments-replace-me
STORAGE_MODE=aws
# STORAGE_SIGNING_SECRET is only used by the local (non-AWS) storage adapter.
STORAGE_SIGNING_SECRET=
# S3_ENDPOINT=
# S3_PATH_STYLE_ACCESS=false

# --- AWS Secrets Manager (optional: deploy.sh can render .env values from it) ---
# SECRETS_MANAGER_SECRET_ID=devsphere/prod/env

# --- Quartz cron overrides (Spring cron: sec min hour dom month dow) ---
# DEVSPHERE_QUARTZ_CRON_OVERDUE_SCAN=0 */5 * * * ?
# DEVSPHERE_QUARTZ_CRON_WEBHOOK_RETRY=0 */5 * * * ?
# DEVSPHERE_QUARTZ_CRON_OUTBOX_DISPATCH=0 */5 * * * ?
# DEVSPHERE_QUARTZ_CRON_GITHUB_BACKFILL=0 */30 * * * ?
# DEVSPHERE_QUARTZ_CRON_DAILY_REPORT=0 0 8 * * ?
# DEVSPHERE_QUARTZ_CRON_NIGHTLY_BACKUP=0 0 2 * * ?

# --- SMTP (password recovery and notification email) ---
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-grafana-password
# Prometheus scrapes /actuator/prometheus (ROLE_ADMIN) with a bearer token stored
# in infra/monitoring/prometheus/secrets/admin-token (git-ignored, chmod 600).

# --- Encrypted PostgreSQL backups (infra/backup) ---
BACKUP_ENCRYPTION_KEY=replace-with-a-random-passphrase-of-at-least-32-characters
BACKUP_S3_BUCKET=devsphere-backups-replace-me
BACKUP_S3_PREFIX=postgres
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4

# --- Monitoring scrape account ---
# A dedicated ROLE_ADMIN user whose short-lived access token is refreshed for Prometheus
# by infra/monitoring/refresh-scrape-token.sh (cron, every 10 minutes).
MONITORING_ADMIN_EMAIL=monitoring@example.com
MONITORING_ADMIN_PASSWORD=replace-with-a-random-monitoring-password
# Directory with encrypted backups; mounted read-only into the backend for the nightly BACKUP_CHECK job.
BACKUP_HOST_DIR=./backups
